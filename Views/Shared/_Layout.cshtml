@{
var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>   
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Rune'ye Hoş Geldiniz</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="~/images/icon/RuneIcon.png">
</head>
<body>
    <header>
        <div class="navbar-container">
            <div>
                <a class="rune-icon">
                <img src="~/images/icon/RuneWebIconStyle.png">
                </a>
            </div>
            <div class="navbar-middle">
                <a asp-controller="Home" asp-action="Index" class="@(currentController == "Home" ? "active" : "")">
                    <img src="https://img.icons8.com/?size=100&id=489&format=png&color=000000" alt=""> Mağaza
                </a>
                <a asp-controller="Library" asp-action="Index"
                class="@(currentController == "Library" ? "active" : "")">
                    <img src="https://img.icons8.com/?size=100&id=NVBQfAAOvi9A&format=png&color=000000" alt=""> Kütüphane
                </a>
                <a href="#">
                    <img src="https://img.icons8.com/?size=100&id=101316&format=png&color=000000" alt=""> Topluluk
                </a>
                <a href="#">
                    <img src="https://img.icons8.com/?size=100&id=0XwEi0yisdO8&format=png&color=000000" alt=""> Haberler
                </a>
                <a href="#">
                    <img src="https://img.icons8.com/?size=100&id=16140&format=png&color=000000" alt=""> Destek
                </a>
                <span class="nav-divider"></span>
                <a href="#">
                    <img class="img-icon" src="https://img.icons8.com/?size=100&id=cYqkhYrpp4xs&format=png&color=d90000" alt=""> Rune'yi İndir
                </a>
            </div>
            <div class="navbar-right">
                
                @* diller eklenecek *@

                <div class="wishlist-icon">
                    <div class="utility-item">
                        <a href="#">
                            <img src="https://img.icons8.com/?size=100&id=sSZiheZL0ozl&format=png&color=000000" title="İstek Listesi" alt="">
                        </a>
                    </div>
                    <div class="utility-item">
                        <a title="Bildirimler" href="#">
                            <img src="https://img.icons8.com/?size=100&id=iBXDn4eGtFfA&format=png&color=000000" alt="">
                        </a>
                    </div>
                    <div class="utility-item">
                        <a title="Sepetim" href="#">
                            <img src="https://img.icons8.com/?size=100&id=Nf4fef5uGONQ&format=png&color=000000" alt="">
                        </a>
                    </div>
                </div>
                <div class="profile-card">
                    <a class="user-icon" title="Profilim" href="#">
                        <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=000000" alt="">
                    </a>
                    <div class="profile-info">
                        <h6 class="profile-name">LerwyN</h6>
                        <p class="profile-level">Seviye 12</p>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
