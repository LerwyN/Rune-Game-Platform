@{
var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="tr">
<head>   
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" href="~/images/icon/RuneIcon.png">
</head>
<body>

<header>
    <div class="navbar-container">
        <div class="navbar-logo">
            <a asp-controller="Home" asp-action="Index" class="rune-icon">
                <img src="~/images/icon/RuneWebIconStyle.png" alt="RUNE">
                <p class="version">Version: Beta</p>
            </a>
        </div>
        <nav class="navbar-middle">
            <a asp-controller="Home" asp-action="Index"
                class="@(currentController == "Home" ? "active" : "")"
                title="Sıradaki Maceranı Keşfet">
                <img src="https://img.icons8.com/?size=100&id=489&format=png&color=000000" alt="">
                Mağaza
            </a>
            <a asp-controller="Library" asp-action="Index"
                class="@(currentController == "Library" ? "active" : "")"
                title="Oyunların, Senin Dünyan">
                <img src="https://img.icons8.com/?size=100&id=NVBQfAAOvi9A&format=png&color=000000" alt="">
                Kütüphane
            </a>
            <a asp-controller="Community" asp-action="Index"
                class="@(currentController == "Community" ? "active" : "")"
                title="Oyun Dünyasının Buluşma Noktası">
                <img src="https://img.icons8.com/?size=100&id=101316&format=png&color=000000" alt="">
                Topluluk
            </a>
            <a asp-controller="News" asp-action="Index"
                class="@(currentController == "News" ? "active" : "")"
                title="Oyun Dünyasından Haberdar Ol">
                <img src="https://img.icons8.com/?size=100&id=0XwEi0yisdO8&format=png&color=000000" alt="">
                Haberler
            </a>
            <a asp-controller="Support" asp-action="Index"
                class="@(currentController == "Support" ? "active" : "")"
                title="Her Adımda Yanındayız">
                <img src="https://img.icons8.com/?size=100&id=16140&format=png&color=000000" alt="">
                Destek
            </a>
            <span class="nav-divider"></span>
            <a href="#" title="Oyun Dünyası Seni Bekliyor">
                <img class="img-icon" src="https://img.icons8.com/?size=100&id=cYqkhYrpp4xs&format=png&color=d90000" alt="">
                RUNE'yi İndir
            </a>
            <span class="nav-active-pill"></span>
        </nav>
        <div class="navbar-right">

            @* Diller eklenecek *@

            <div class="wishlist-icon">
                <div class="utility-item">
                    <a href="#" title="İstek Listesi">
                        <img src="https://img.icons8.com/?size=100&id=sSZiheZL0ozl&format=png&color=000000" alt="">
                    </a>
                </div>
                <div class="utility-item">
                    <a href="#" title="Bildirimler">
                        <img src="https://img.icons8.com/?size=100&id=iBXDn4eGtFfA&format=png&color=000000" alt="">
                    </a>
                </div>
                <div class="utility-item">
                    <a href="#" title="Sepetim">
                        <img src="https://img.icons8.com/?size=100&id=Nf4fef5uGONQ&format=png&color=000000" alt="">
                    </a>
                </div>
            </div>
        
            <div class="profile-card">
                <a class="user-icon" title="Profilim" href="#">
                    <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=000000" alt="">
                </a>
                <div class="profile-info">
                    <h6 class="profile-name">LerwyN</h6>
                    <p class="profile-level">Seviye 12</p>
                </div>
                <button class="profile-menu-toggle" id="profileMenuToggle" type="button" aria-label="Profil menüsünü aç" aria-expanded="false">
                    <img class="" src="https://img.icons8.com/?size=100&id=99991&format=png&color=000000" alt="">
                </button>
                <div class="profile-dropdown" id="profileDropdown">
                    <div class="profile-dropdown-header">
                        <strong>LerwyN &</strong>
                        <span> Seviye 12 · Admin</span>
                    </div>
                    <a href="#" class="profile-dropdown-item">
                        <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=000000" alt=""> Profilim
                    </a>
                    <a href="#" class="profile-dropdown-item">
                        <img src="https://img.icons8.com/?size=100&id=4511GGVppfIx&format=png&color=000000" alt="">Ayarlar
                    </a>
                    <div class="profile-dropdown-divider"></div>
                    <button type="button" class="profile-dropdown-item dark-theme-btn">
                        <img src="https://img.icons8.com/?size=100&id=xlD3xOrQjTJO&format=png&color=000000" alt="">Koyu Tema
                    </button>
                    <button type="button" class="profile-dropdown-item light-theme-btn">
                        <img src="https://img.icons8.com/?size=100&id=648&format=png&color=000000" alt=""> Beyaz Tema
                    </button>
                    <div class="profile-dropdown-divider"></div>
                    <button type="button" class="profile-dropdown-item logout-link">
                        <img src="https://img.icons8.com/?size=100&id=3HSHWjvK9Yxq&format=png&color=d90000" alt="">Çıkış Yap
                    </button>
                </div>
            </div>
        </div>
        <button class="mobile-menu-button"
                id="mobileMenuToggle"
                type="button"
                aria-label="Menüyü aç"
                aria-expanded="false"
                aria-controls="mobileMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
    <nav class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-profile">
            <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=000000" alt="Profil">
            <div>
                <strong>LerwyN</strong>
                <p>Seviye 12</p>
            </div>
        </div>
        <a asp-controller="Home" asp-action="Index">
            <img src="https://img.icons8.com/?size=100&id=489&format=png&color=000000" alt="">
            Mağaza
        </a>
        <a asp-controller="Library" asp-action="Index">
            <img src="https://img.icons8.com/?size=100&id=NVBQfAAOvi9A&format=png&color=000000" alt="">
            Kütüphane
        </a>
        <a asp-controller="Community" asp-action="Index">
            <img src="https://img.icons8.com/?size=100&id=101316&format=png&color=000000" alt="">
            Topluluk
        </a>
        <a asp-controller="News" asp-action="Index">
            <img src="https://img.icons8.com/?size=100&id=0XwEi0yisdO8&format=png&color=000000" alt="">
            Haberler
        </a>
        <a asp-controller="Support" asp-action="Index">
            <img src="https://img.icons8.com/?size=100&id=16140&format=png&color=000000" alt="">
            Destek
        </a>
        <div class="mobile-menu-divider"></div>
        <a href="#">
            <img src="https://img.icons8.com/?size=100&id=sSZiheZL0ozl&format=png&color=000000" alt="">
            İstek Listem
        </a>
        <a href="#">
            <img src="https://img.icons8.com/?size=100&id=iBXDn4eGtFfA&format=png&color=000000" alt="">
            Bildirimler
        </a>
        <a href="#">
            <img src="https://img.icons8.com/?size=100&id=Nf4fef5uGONQ&format=png&color=000000" alt="">
            Sepetim
        </a>
        <a href="#">
            <img src="https://img.icons8.com/?size=100&id=mj4zUKpD4IjJ&format=png&color=000000" alt="">
            Profilim
        </a>
        <a href="#">
            <img src="https://img.icons8.com/?size=100&id=4511GGVppfIx&format=png&color=000000" alt="">
            Ayarlar
        </a>
        <a href="#" class="logout-link">
            <img src="https://img.icons8.com/?size=100&id=24338&format=png&color=d90000" alt="">
            Çıkış Yap
        </a>
    </nav>
</header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
