<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RUNE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RUNE.site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="navbar-container">
            <div>
                <a href="/">
                <img src="/wwwroot/images/icon/RuneIcon.png.png" alt="">
                </a>
            </div>
            <div class="">
                <a href="#">Mağaza</a>
                <a href="#">Kütüphane</a>
                <a href="#">Topluluk</a>
                <a href="#">Haberler</a>
                <a href="#">RUNE'yi indirin</a>
            </div>
            <div class="navbar-right">
                <div>
                    <div class="dropdown">
                        <a class="btn btn-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            TR
                        </a>

                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item">Türkçe</a></li>
                            <li><a class="dropdown-item">Ingilizce</a></li>
                            <li><a class="dropdown-item">Almanca</a></li>
                        </ul>
                    </div>
                </div>
                <div>
                    <a href="#">İstek Listesi</a>
                    <a href="#">Bildirimler</a>
                    <a href="#">Sepetim</a>
                </div>
                <div>
                    <a href="#">Profilim</a>
                </div>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RUNE - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
